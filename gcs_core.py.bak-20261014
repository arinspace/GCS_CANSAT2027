# ══════════════════════════════════════════════════════════════════════════════
#  Parsing helpers
# ══════════════════════════════════════════════════════════════════════════════

NAN_TOKENS = {"NAN", "NA", "N/A", "N/C", "---", "", "NONE", "NULL"}


def calc_checksum(s):
    x = 0
    for c in s:
        x ^= ord(c)
    return x


def verify_line(raw):
    """Return (payload, status) — status = 'OK' | 'FAIL' | 'NONE' (no checksum)."""
    raw = raw.strip()
    if "*" not in raw:
        return raw, "NONE"
    idx = raw.rfind("*")
    data, chk_s = raw[:idx], raw[idx + 1:]
    try:
        return data, ("OK" if int(chk_s, 16) == calc_checksum(data) else "FAIL")
    except Exception:
        return data, "FAIL"


def to_float(v):
    """NaN / sensor failure -> None (must not break the other fields)."""
    if v is None:
        return None
    s = str(v).strip()
    if s.upper() in NAN_TOKENS:
        return None
    try:
        f = float(s)
    except Exception:
        return None
    return None if math.isnan(f) else f


def to_int(v):
    f = to_float(v)
    return None if f is None else int(f)


def parse_hex(v):
    if v is None:
        return None
    s = str(v).strip().upper().replace("0X", "")
    if s in NAN_TOKENS or not s:
        return None
    try:
        return int(s, 16)
    except Exception:
        return None


def show(v, decimals=None):
    if v is None:
        return NONE_TEXT
    if isinstance(v, float):
        if math.isnan(v):
            return NONE_TEXT
        return f"{v:.{decimals if decimals is not None else 2}f}"
    s = str(v).strip()
    if s.upper() in NAN_TOKENS:
        return NONE_TEXT
    if decimals is not None:
        f = to_float(s)
        if f is not None:
            return f"{f:.{decimals}f}"
    return s


def field_text(d, key):
    """Display value with units, per the resolution in the spec."""
    raw = d.get(key)
    dec = DECIMALS.get(key)
    txt = show(raw, dec)
    unit = UNITS.get(key)
    if txt != NONE_TEXT and unit:
        return f"{txt} {unit}"
    return txt


def parse_gnss_time(raw) -> str:
    """
    Convert GNSS_TIME from NMEA GPS format (HHMMSS.SS or HHMMSS)
    to a readable HH:MM:SS UTC.
    If it cannot be parsed → return the original raw string.
    Examples: '143025.00' → '14:30:25 UTC'
              '093000'   → '09:30:00 UTC'
    """
    if raw is None:
        return NONE_TEXT
    s = str(raw).strip()
    if not s or s.upper() in NAN_TOKENS:
        return NONE_TEXT
    try:
        int_part = s.split(".")[0]
        if len(int_part) < 6:
            return s
        hh = int(int_part[0:2])
        mm = int(int_part[2:4])
        ss = int(int_part[4:6])
        if 0 <= hh <= 23 and 0 <= mm <= 59 and 0 <= ss <= 59:
            return f"{hh:02d}:{mm:02d}:{ss:02d} UTC"
        return s
    except (ValueError, IndexError):
        return s


def parse_packet(raw):
    """
    Split packets by ID suffix: 1059C -> container, 1059P -> PocketQube.
    Return a dict, or None if not ours / too short (X4/X5).
    """
    data, chk = verify_line(raw)
    parts = [p.strip() for p in data.split(",")]
    if not parts or not parts[0]:
        return None
    pid = parts[0].strip().upper()
    if pid == CONTAINER_ID:
        vehicle, fields = "C", CONTAINER_FIELDS
    elif pid == PQ_ID:
        vehicle, fields = "P", PQ_FIELDS
    else:
        return None
    if len(parts) < len(fields):
        return None

    d = {fields[i]: parts[i] for i in range(len(fields))}
    d["_VEHICLE"] = vehicle
    d["_EXTRA"] = parts[len(fields):] if vehicle == "P" else []
    d["_CHECKSUM"] = chk
    d["_RAW"] = raw.strip()
    d["_RECV_TIME"] = datetime.datetime.now().strftime("%H:%M:%S.%f")[:-3]
    d["_MECH"] = parse_hex(d.get("MECH_STATE"))
    d["_PKT"] = to_int(d.get("PACKET_COUNT"))
    return d


def extra_column_names(n):
    """
    Name the PQ trailing-field columns for the CSV header.
    The first n (= IMAGE_STAB_FIELD_COUNT) are IMAGE_STABILIZATION, the rest are
    SCIENCE_EXP, in PQ_TRAILING order.
    """
    img_name, sci_name = PQ_TRAILING
    names = []
    for i in range(n):
        if i < IMAGE_STAB_FIELD_COUNT:
            names.append(f"{img_name}_{i + 1}")
        else:
            names.append(f"{sci_name}_{i - IMAGE_STAB_FIELD_COUNT + 1}")
    return names


# Internal name (button / virtual payload) -> actual on-air body per SPEC §9.  {arg} = typed value
WIRE_ALIASES = {
    "SOLAR_ON":  ["MEC,SOLAR1,ON", "MEC,SOLAR2,ON"],
    "SOLAR_OFF": ["MEC,SOLAR1,OFF", "MEC,SOLAR2,OFF"],
    "BOOM_ON":   ["MEC,BOOM,ON"],
    "BOOM_OFF":  ["MEC,BOOM,OFF"],
    "CAM_SET":   ["MEC,ROT,{arg}"],
}
ECHO_MAX = 15                   # SPEC §5.10: CMD_ECHO <= 15 characters
CAM_TURN_ECHOES = ("CAMSET", "MECROT")


def wire_commands(name, arg=None, vehicle=None):
    """
    The single place in the program that turns "command name + argument" into the radio string
    (returns a list because some commands need two lines, e.g. SOLAR_ON = SOLAR1 + SOLAR2).
    vehicle 'C'/'P' -> team field = 1059C / 1059P (X5); None -> 1059.
        wire_commands("SIMP", 101325, "C") -> ['CMD,1059C,SIMP,101325']
        wire_commands("BOOM_ON", None, "P") -> ['CMD,1059P,MEC,BOOM,ON']
    """
    key = "_".join(str(name).upper().split())
    arg = "" if arg is None else str(arg).strip()
    if key.startswith("MEC") and arg:
        arg = ",".join(arg.replace(",", " ").split())      # 'BOOM ON' -> 'BOOM,ON'
    if key in WIRE_ALIASES:
        bodies = [b.replace("{arg}", arg) for b in WIRE_ALIASES[key]]
    else:
        body = ",".join(str(name).split())
        if arg:
            body += "," + arg
        bodies = [body]
    team = {"C": CONTAINER_ID, "P": PQ_ID}.get(vehicle, str(TEAM_ID))
    return [COMMAND_WIRE_TEMPLATE.replace("<TEAM>", team).replace("<BODY>", b)
            for b in bodies]


def wire_command(name, arg=None, vehicle=None):
    """First line of wire_commands() — for single-line commands."""
    return wire_commands(name, arg, vehicle)[0]


def expected_echo(wire):
    """CMD_ECHO the FSW should return: body only, uppercase, no commas, <= ECHO_MAX."""
    body = wire.split(",", 2)[2] if wire.count(",") >= 2 else wire
    return echo_token(body)[:ECHO_MAX]


def echo_token(name):
    # ':' dropped too: ST,12:30:45 is echoed ST123045 (FSW COMMANDS.md)
    return (str(name).upper().replace(" ", "").replace(",", "").replace("_", "")
            .replace(":", ""))


def pressure_pa_to_alt(pa, sea_level_pa=SEA_LEVEL_PA):
    """Standard barometric formula — Pa -> metres (relative to sea_level_pa)."""
    if pa is None or pa <= 0:
        return None
    try:
        return 44330.0 * (1.0 - (pa / sea_level_pa) ** 0.1903)
    except Exception:
        return None


def alt_to_pressure_pa(alt_m, sea_level_pa=SEA_LEVEL_PA):
    return sea_level_pa * (1.0 - 2.25577e-5 * alt_m) ** 5.25588


# ══════════════════════════════════════════════════════════════════════════════
#  GS8 — Pressure profile reader
#  Must read the "judges' file" without editing it (The pressure profile data file
#  will be provided by the competition judges).  The format is not specified in the
#  guide, so every format seen so far is supported and auto-detected.
# ══════════════════════════════════════════════════════════════════════════════

PROFILE_FORMATS = {
    "SIMP_COMMANDS": "Command lines CMD,<TEAMID>,SIMP,<Pa>",
    "CSV_PRESSURE_COLUMN": "CSV with a PRESSURE column header",
    "BARE_NUMBERS": "Single column of pressure numbers",
}


def _detect_unit(values):
    """
    Guess the unit from the median. Never converts by itself — returns the unit name so the UI asks the user first.
    A silent wrong unit conversion invalidates the whole demonstration run.
    """
    if not values:
        return "UNKNOWN", 1.0
    med = statistics.median(values)
    if PA_RANGE[0] <= med <= PA_RANGE[1]:
        return "Pa", 1.0
    if KPA_RANGE[0] <= med <= KPA_RANGE[1]:
        return "kPa", 1000.0
    if HPA_RANGE[0] <= med <= HPA_RANGE[1]:
        return "hPa/mbar", 100.0
    return "UNKNOWN", 1.0


def load_pressure_profile(path):
    """
    Returns a dict:
        rows      : [(raw_text, value_float), ...]  in file order
        fmt       : key in PROFILE_FORMATS
        unit      : 'Pa' | 'kPa' | 'hPa/mbar' | 'UNKNOWN'
        factor    : multiplier that *would* be used if the user confirms conversion to Pa
        n         : number of rows
        pmin/pmax : min/max pressure (in the file's unit)
    Raises ValueError if there are no usable rows.
    """
    with open(path, "r", encoding="utf-8-sig", errors="replace") as f:
        raw_lines = f.read().splitlines()

    lines = []
    for ln in raw_lines:
        s = ln.strip()
        if not s or s.startswith("#"):        # skip blank and comment lines
            continue
        lines.append(s)
    if not lines:
        raise ValueError("File is empty or has only comment lines")

    rows = []
    fmt = None

    # ── Format 1: command lines CMD,<TEAMID>,SIMP,<Pa> ────────────────────────
    if any(",SIMP," in ln.upper() for ln in lines):
        fmt = "SIMP_COMMANDS"
        for n, ln in enumerate(lines, start=1):
            up = ln.upper()
            if ",SIMP," not in up:
                continue
            idx = up.rindex(",SIMP,")
            tail = ln[idx + len(",SIMP,"):].split(",")[0].strip()
            v = to_float(tail)
            if v is None:
                raise ValueError(f"Invalid pressure value at line {n}: {ln[:60]}")
            # <TEAMID> may be a placeholder or a real team number — we don't care
            # because the command is always rebuilt with our own TEAM_ID
            rows.append((tail, v))
    else:
        parsed = [[c.strip() for c in r] for r in csv.reader(lines)]
        header = [c.upper().replace(" ", "").replace("_", "") for c in parsed[0]]
        col_idx, start = None, 0
        for i, c in enumerate(header):
            if "PRESSURE" in c or c in {"KPA", "PA", "HPA", "MBAR"}:
                col_idx, start, fmt = i, 1, "CSV_PRESSURE_COLUMN"
                break
        if col_idx is None:
            # ── Format 3: bare numbers, single column ──────────────────────────
            if to_float(parsed[0][0]) is None:
                raise ValueError("Unreadable — expected CMD,...,SIMP,<Pa> lines "
                                 "or a CSV with a PRESSURE column "
                                 "or a single column of pressure numbers")
            col_idx, start, fmt = 0, 0, "BARE_NUMBERS"
        for n, row in enumerate(parsed[start:], start=start + 1):
            if col_idx >= len(row) or not row[col_idx]:
                continue
            v = to_float(row[col_idx])
            if v is None:
                raise ValueError(f"Invalid pressure value at line {n}: "
                                 f"{row[col_idx]}")
            rows.append((row[col_idx], v))

    if not rows:
        raise ValueError("No usable pressure rows found in this file")

    vals = [v for _, v in rows]
    unit, factor = _detect_unit(vals)
    return dict(rows=rows, fmt=fmt, unit=unit, factor=factor, n=len(rows),
                pmin=min(vals), pmax=max(vals), path=path)


def profile_summary(info):
    """Summary text used both in the confirmation dialog and the event log."""
    a_hi = pressure_pa_to_alt(info["pmin"] * info["factor"])
    a_lo = pressure_pa_to_alt(info["pmax"] * info["factor"])
    dur = info["n"] / SIMP_PERIOD_S if SIMP_PERIOD_S else 0
    return (f"Format: {PROFILE_FORMATS.get(info['fmt'], info['fmt'])}\n"
            f"Rows: {info['n']}   ({dur:.0f} s at 1 Hz)\n"
            f"Pressure: {info['pmin']:.0f} .. {info['pmax']:.0f} "
            f"(detected unit: {info['unit']})\n"
            f"Implied altitude: {show(a_lo, 1)} .. {show(a_hi, 1)} m")


# ══════════════════════════════════════════════════════════════════════════════
#  Link layer
# ══════════════════════════════════════════════════════════════════════════════

class LinkReader(threading.Thread):
    """One thread per radio — reconnects by itself when the port drops (as in b.py)."""

    def __init__(self, key, cfg, rx_q, tx_q, stop_ev):
        super().__init__(daemon=True, name=f"reader-{key}")
        self.key = key
        self.port = cfg["port"]
        self.baud = int(cfg["baud"])
        self.rx_q = rx_q
        self.tx_q = tx_q
        self.stop_ev = stop_ev

    def _status(self, msg, connected=None):
        self.rx_q.put(("STATUS", self.key, msg, connected))

    def run(self):
        while not self.stop_ev.is_set():
            ser = None
            try:
                ser = serial.Serial(self.port, self.baud, timeout=1)
                self._status(f"connected {self.port} @ {self.baud}", True)
                while not self.stop_ev.is_set():
                    while not self.tx_q.empty():
                        try:
                            cmd = self.tx_q.get_nowait()
                        except queue.Empty:
                            break
                        ser.write((cmd + "\n").encode())
                        self.rx_q.put(("TX", self.key, cmd, None))
                    line = ser.readline().decode("utf-8", errors="replace").strip()
                    if line:
                        self.rx_q.put(("DATA", self.key, line, None))
            except Exception as e:
                self._status(f"port error: {e}", False)
                if self.stop_ev.wait(2.0):
                    break
            finally:
                try:
                    if ser is not None:
                        ser.close()
                except Exception:
                    pass
        self._status("stopped", False)


class LinkManager:
    """Holds the 4 readers + one tx queue per link. Dedupe happens in the UI thread."""

    def __init__(self, rx_q):
        self.rx_q = rx_q
        self.cfg = {k: dict(v) for k, v in DEFAULT_LINKS.items()}
        self.readers = {}
        self.stop_evs = {}
        self.tx_qs = {k: queue.Queue() for k in LINK_KEYS}

    # ── config persistence ────────────────────────────────────────────────
    def load_config(self, path=CONFIG_FILE):
        if not os.path.exists(path):
            return False, f"{os.path.basename(path)} not found — using defaults"
        try:
            with open(path, "r", encoding="utf-8") as f:
                saved = json.load(f)
            for k in LINK_KEYS:
                if k in saved and isinstance(saved[k], dict):
                    self.cfg[k].update(
                        {kk: saved[k][kk] for kk in
                         ("port", "baud", "channel", "netid", "peer_mac")
                         if kk in saved[k]})
            return True, f"Loaded {os.path.basename(path)}"
        except Exception as e:
            return False, f"Cannot read config: {e}"

    def save_config(self, path=CONFIG_FILE):
        try:
            with open(path, "w", encoding="utf-8") as f:
                json.dump(self.cfg, f, indent=2, ensure_ascii=False)
            return True, f"Saved {os.path.basename(path)}"
        except Exception as e:
            return False, f"Cannot save config: {e}"

    # ── validation (Mission Guide X2/X3/X6) ───────────────────────────────
    def validate(self):
        warns = []
        ports = {}
        for k in LINK_KEYS:
            c = self.cfg[k]
            mac = (c.get("peer_mac") or "").strip().upper()
            if c["radio"] == "ESPNOW":
                if mac.replace("-", ":") == BROADCAST_MAC:
                    warns.append(f"[X6] {k}: broadcast MAC not allowed "
                                 f"{BROADCAST_MAC}")
                elif not mac:
                    warns.append(f"[X3] {k}: peer MAC not set — must be the MAC "
                                 f"of the ground station radio")
                ch = str(c.get("channel", "")).strip()
                if ch and ch not in ESPNOW_CLEAN_CHANNELS:
                    warns.append(f"[X2] {k}: ESPNOW channel {ch} is not 1/6/11 "
                                 f"(the non-overlapping channels)")
            else:
                if not str(c.get("netid", "")).strip():
                    warns.append(f"{k}: XBee NETID/PANID empty — must be the team number "
                                 f"{TEAM_ID}")
            p = (c.get("port") or "").strip()
            if p:
                ports.setdefault(p, []).append(k)

        for radio in RADIOS:
            ck = self.cfg[link_key("C", radio)].get("channel", "")
            pk = self.cfg[link_key("P", radio)].get("channel", "")
            if str(ck).strip() and str(ck).strip() == str(pk).strip():
                warns.append(f"[X2] {RADIO_LABEL[radio]}: container and "
                             f"PocketQube use the same channel ({ck}) "
                             f"— they must differ")

        for p, ks in ports.items():
            if len(ks) > 1:
                warns.append(f"Port {p} is used more than once in {', '.join(ks)}")
        return warns

    # ── connect / disconnect ──────────────────────────────────────────────
    def is_connected(self, key):
        r = self.readers.get(key)
        return r is not None and r.is_alive()

    def any_connected(self):
        return any(self.is_connected(k) for k in LINK_KEYS)

    def connect(self, key):
        if self.is_connected(key):
            return False, "Already connected"
        cfg = self.cfg[key]
        if not (cfg.get("port") or "").strip():
            return False, "No serial port selected"
        ev = threading.Event()
        self.stop_evs[key] = ev
        r = LinkReader(key, cfg, self.rx_q, self.tx_qs[key], ev)
        self.readers[key] = r
        r.start()
        return True, f"Opened {key} on {cfg['port']}"

    def disconnect(self, key):
        ev = self.stop_evs.get(key)
        if ev:
            ev.set()
        self.readers.pop(key, None)
        return True, f"Closed {key}"

    def send(self, key, cmd):
        """Send on the selected link only — no fan-out to both radios."""
        self.tx_qs[key].put(cmd)

    def shutdown(self):
        for ev in self.stop_evs.values():
            ev.set()
        for r in list(self.readers.values()):
            if r.is_alive():
                r.join(timeout=1.5)


# ══════════════════════════════════════════════════════════════════════════════
#  VirtualPayload — "loopback virtual CanSat"
# ══════════════════════════════════════════════════════════════════════════════
#  This simulator behaves exactly like the real flight software where the rules apply:
#
#   F6 / GS16  Only SIM ENABLE followed by SIM ACTIVATE enters
#              SIMULATION mode — any SIMP received before that is "discarded"
#   F5         In SIM mode, use the pressure sent by the ground station
#              instead of the real sensor, and compute altitude from it
#   line 1249  The resulting altitude drives the state machine (ascent detection, apogee,
#              and the PocketQube release point at 90% apogee)
#   line 1215  Other values (battery, temperature, IMU, GNSS) are normal sensor values
#   MODE       'S' during SIM mode, 'F' otherwise
#   RATES      PocketQube PQ_RATE_HZ (4 Hz); container CONT_RATE_HZ_PRE (4 Hz) until
#              CONT_RATE_SWITCH_DELAY_S after PQ release, then CONT_RATE_HZ_POST (1 Hz)
# ══════════════════════════════════════════════════════════════════════════════

class VirtualPayload(threading.Thread):
    DT = 0.25                    # base tick = 4 Hz (container drops to 1 Hz after release)

    # "Real sensor" profile used when *not* in SIM mode
    APOGEE_M = 700.0
    T_LAUNCH = 6.0
    T_APOGEE = 26.0
    T_LANDED = 105.0

    # State machine thresholds (shared by flight and simulation)
    ASCENT_M = 15.0              # above this = ascending
    APOGEE_DROP_M = 8.0          # this far below the peak = apogee passed (noise guard)
    LANDED_M = 8.0               # below this after having climbed = landed
    RELEASE_FRAC = 0.90          # release the PQ at 90% of apogee
    SOLAR_DELAY_S = 5.0          # deploy solar 5 s after release
    BOOM_DELAY_S = 10.0          # deploy boom 10 s after release

    def __init__(self, rx_q, stop_ev, speed=1.0):
        super().__init__(daemon=True, name="virtual-payload")
        self.rx_q = rx_q
        self.stop_ev = stop_ev
        self.speed = max(0.1, speed)
        self.lock = threading.Lock()
        self.flip_by_vehicle = {"C": 0, "P": 0}
        self._reset_mission_fields()

    def _reset_mission_fields(self):
        """Set all "per-mission" state — called from __init__ and reset."""
        self.t = 0.0
        self.c_pkt = 0
        self.p_pkt = 0
        self.c_cmd = 0
        self.p_cmd = 0
        self.c_echo = "NONE"
        self.p_echo = "NONE"

        # ── payload-side SIM state (independent of the ground-station side) ───────
        self.sim_state = {"C": "IDLE", "P": "IDLE"}
        self.simp_pa = {"C": None, "P": None}     # latest value sent by the uplink
        self.simp_rx = {"C": 0, "P": 0}           # SIMP values actually used
        self.simp_ignored = {"C": 0, "P": 0}      # SIMP dropped because not armed yet
        self.ground_pa = {"C": SEA_LEVEL_PA, "P": SEA_LEVEL_PA}
        self.need_zero = {"C": False, "P": False}

        # ── state machine driven by the computed altitude ───────────────────
        self.max_alt = 0.0
        self.apogee_alt = None
        self.c_state = "LAUNCH_PAD"
        self.t_release = None
        self.cam_turned = False
        self.c_mech = 0
        self.p_mech = 0
        self._c_next_emit_t = None       # sim time the next container packet is due

        # ── boom uplink reminder / fail-safe (no clock-based auto-deploy anymore) ─
        self.boom_cmd_sent = False       # BOOM_ON pressed / auto-fired yet?
        self._boom_window_notified = False   # uplink-window reminder already sent?
        self._cam_reminder_sent = False      # CAM_SET reminder already sent? (once)

    def reset_mission(self):
        """SIM DISABLE — reset the mission to its initial state for a clean new demo."""
        with self.lock:
            self._reset_mission_fields()
        self._status("virtual CanSat: mission reset to its initial state")

    # ── uplink into the payload ───────────────────────────────────────────
    def command(self, vehicle, name, arg=None, echo=None):
        """
        Called from the UI thread when the ground station sends a command.
        The payload responds like the real FSW: counts COMMAND_COUNT, sets CMD_ECHO,
        and *enforces the two-step arming gate* before accepting SIMP.
        """
        tok = echo_token(name)
        with self.lock:
            if vehicle == "C":
                self.c_cmd += 1
                self.c_echo = echo or tok
            else:
                self.p_cmd += 1
                self.p_echo = echo or tok

            if tok == "SIMENABLE":
                self.sim_state[vehicle] = "ENABLED"
                self._status(f"virtual {VEHICLE_NAME[vehicle]}: SIM ENABLED "
                             f"(step 1/2)")
            elif tok == "SIMACTIVATE":
                if self.sim_state[vehicle] == "ENABLED":
                    self.sim_state[vehicle] = "ACTIVE"
                    self.need_zero[vehicle] = True
                    self.simp_pa[vehicle] = None
                    self._status(f"virtual {VEHICLE_NAME[vehicle]}: SIMULATION "
                                 f"MODE ACTIVE — MODE = S (step 2/2)")
                else:
                    self._status(f"virtual {VEHICLE_NAME[vehicle]}: rejected "
                                 f"SIM ACTIVATE — SIM ENABLE not received yet (F6)")
            elif tok in ("SIMDISABLE", "SIMDEACTIVATE", "SIMPDEACTIVATE"):
                self.sim_state[vehicle] = "IDLE"
                self.simp_pa[vehicle] = None
                self._status(f"virtual {VEHICLE_NAME[vehicle]}: left SIM mode "
                             f"— MODE = F")
            elif tok == "SIMP":
                v = to_float(arg)
                if self.sim_state[vehicle] != "ACTIVE":
                    self.simp_ignored[vehicle] += 1
                    if self.simp_ignored[vehicle] in (1, 5, 20):
                        self._status(
                            f"virtual {VEHICLE_NAME[vehicle]}: dropped SIMP "
                            f"({self.simp_ignored[vehicle]} values) — not in "
                            f"SIMULATION mode (F6)")
                elif v is not None and v > 0:
                    if self.need_zero[vehicle]:
                        # Implicit CAL: the first pressure received = field ground level
                        self.ground_pa[vehicle] = v
                        self.need_zero[vehicle] = False
                    self.simp_pa[vehicle] = v
                    self.simp_rx[vehicle] += 1
            elif tok == "CAL":
                cur = self._pressure(vehicle, self.t)
                self.ground_pa[vehicle] = cur
                self._status(f"virtual {VEHICLE_NAME[vehicle]}: CAL — ground "
                             f"pressure set to {cur:.0f} Pa")
            elif tok == "MECRELEASEON" and vehicle == "C":
                if self.t_release is None:
                    self.c_state = "PQ_RELEASE"
                    self.t_release = self.t
                    self.c_mech |= (1 << C_BIT_MECH_ACTIVE)
                    self._status("virtual CONTAINER: MEC RELEASE ON — "
                                 "PocketQube released manually")
            elif tok == "CAMSET":
                self.cam_turned = True
                self._status("virtual POCKETQUBE: CAM_SET — camera rotated "
                             "(entering CAMERA_TURN)")
            elif tok == "BOOMON":
                self.boom_cmd_sent = True
                was_deployed = bool((self.p_mech >> PQ_BIT_BOOM) & 1)
                self.p_mech |= (1 << PQ_BIT_BOOM)
                self._status("virtual POCKETQUBE: BOOM_ON — boom deployed "
                             "(confirmed by magnetometer)")
                if not was_deployed and not self._cam_reminder_sent:
                    self._cam_reminder_sent = True
                    self.rx_q.put(("MECH_WINDOW", None,
                                   {"vehicle": "P", "mech": "CAM",
                                    "auto_after_s": None}, None))
            elif tok == "BOOMOFF":
                self.boom_cmd_sent = False
                self.p_mech &= ~(1 << PQ_BIT_BOOM)
                self._status("virtual POCKETQUBE: BOOM_OFF — boom status cleared")

    def _status(self, msg):
        self.rx_q.put(("STATUS", None, msg, None))

    def sim_mode_flag(self, vehicle):
        return "S" if self.sim_state[vehicle] == "ACTIVE" else "F"

    # ── pressure source: SIMP once armed, otherwise the "real sensor" ─────────
    def _free_flight_alt(self, t):
        # No random values / auto-launch, as the user specified
        return 0.0

    def _pressure(self, vehicle, t):
        """F5 — in SIM mode use the uplinked value instead of the real pressure sensor.

        The _free_flight_alt() curve stands in for the "real sensor" when testing
        flight mode only, so it is used only while IDLE. During the arm sequence
        (ENABLED), or ACTIVE with no SIMP value yet, it must stay at
        ground pressure (AGL = 0), otherwise the plot would climb with no real data.
        """
        st = self.sim_state[vehicle]
        if st == "ACTIVE" and self.simp_pa[vehicle]:
            return self.simp_pa[vehicle]
        if st == "IDLE":
            return alt_to_pressure_pa(self._free_flight_alt(t))
        return self.ground_pa[vehicle]

    def _altitude(self, vehicle, pressure):
        """AGL altitude — from the current pressure relative to the ground pressure set by CAL."""
        a = pressure_pa_to_alt(pressure)
        a0 = pressure_pa_to_alt(self.ground_pa[vehicle])
        if a is None or a0 is None:
            return 0.0
        return a - a0

    # ── state machine driven by altitude (not by the clock) ──────────────
    def _advance_states(self, alt, t):
        if alt > self.max_alt:
            self.max_alt = alt

        if self.c_state == "LAUNCH_PAD":
            if alt >= self.ASCENT_M:
                self.c_state = "ASCENT"
        elif self.c_state == "ASCENT":
            if self.max_alt >= self.ASCENT_M and alt <= self.max_alt - self.APOGEE_DROP_M:
                self.apogee_alt = self.max_alt
                self.c_state = "APOGEE"
                self._status(f"virtual CONTAINER: apogee = {self.apogee_alt:.1f} m "
                             f"— release PQ at "
                             f"{self.RELEASE_FRAC * self.apogee_alt:.1f} m")
        elif self.c_state == "APOGEE":
            if self.apogee_alt and alt <= self.RELEASE_FRAC * self.apogee_alt:
                self.c_state = "PQ_RELEASE"
                self.t_release = t
                self.c_mech |= (1 << C_BIT_MECH_ACTIVE)
                self._status(f"virtual CONTAINER: PocketQube released at "
                             f"{alt:.1f} m (90% apogee)")
        elif self.c_state == "PQ_RELEASE":
            if alt <= self.LANDED_M:
                self.c_state = "LANDED"
                self._status("virtual CONTAINER: LANDED")

        if (self.t_release is not None
                and t > self.t_release + 0.5
                and not (self.c_mech >> C_BIT_PQ_RELEASED) & 1):
            self.c_mech |= (1 << C_BIT_PQ_RELEASED)     # micro switch confirms

        # ── PocketQube mechanisms ────────────────────────────────────────
        if self.t_release is not None:
            dt_rel = t - self.t_release
            self.p_mech |= (1 << PQ_BIT_CAM_REC)        # camera records from separation
            if dt_rel >= self.SOLAR_DELAY_S:
                self.p_mech |= (1 << PQ_BIT_SOLAR_1) | (1 << PQ_BIT_SOLAR_2)
            # boom no longer auto-deploys on a timer — like the real FSW it waits for
            # the BOOM_ON uplink from the ground station (see command() case BOOMON);
            # here we only announce, once, that the window to press it has arrived
            if (dt_rel >= self.BOOM_DELAY_S
                    and not self._boom_window_notified):
                self._boom_window_notified = True
                self.rx_q.put(("MECH_WINDOW", None,
                               {"vehicle": "P", "mech": "BOOM",
                                "auto_after_s": 2.0}, None))

    # ── emission ──────────────────────────────────────────────────────────
    def _emit(self, vehicle, line):
        """Send the same packet out on both radios (parallel, no primary)."""
        raw = f"{line}*{calc_checksum(line):02X}"
        order = list(RADIOS)
        # count per vehicle, otherwise a shared parity makes one vehicle always win the same link
        n = self.flip_by_vehicle[vehicle] = self.flip_by_vehicle[vehicle] + 1
        # alternate every packet — the radios are equal, neither wins systematically
        if n % 2 == 0:
            order.reverse()
        for i, radio in enumerate(order):
            if n % 23 == 0 and i == 1:               # simulate a packet lost on one link
                continue
            self.rx_q.put(("DATA", link_key(vehicle, radio), raw, VIRTUAL_TAG))

    def _container_line(self, t, alt, pres):
        self.c_pkt += 1
        temp = 28.0 - 0.0065 * alt                   # real sensor (not a sim value)
        temp_s = "NaN" if 40.0 < t < 41.5 else f"{temp:.1f}"
        batt_v = 8.2 - 0.002 * t
        batt_i = 320 + 40 * math.sin(t / 3.0)
        return (f"{CONTAINER_ID},{t:.3f},{self.c_pkt},{self.c_cmd},"
                f"{self.sim_mode_flag('C')},"
                f"{alt:.1f},{pres:.0f},{temp_s},{batt_v:.1f},{batt_i:.0f},"
                f"{self.c_mech:02X},{self.c_state},{self.c_echo}")

    def _pq_line(self, t, alt, pres, dt_rel):
        self.p_pkt += 1
        temp = 27.5 - 0.0065 * alt
        volt = 3.9 - 0.001 * dt_rel
        curr = 180 + 25 * math.sin(dt_rel / 2.0)
        lat = MAP_HOME[0] + dt_rel * 0.000035
        lon = MAP_HOME[1] + dt_rel * 0.000022
        sats = 9 if dt_rel > 2 else 5
        gt = datetime.datetime.now(datetime.timezone.utc).strftime("%H:%M:%S")
        rx = 12.0 * math.sin(dt_rel / 1.7)
        ry = 9.0 * math.cos(dt_rel / 2.1)
        rz = 24.0 * math.sin(dt_rel / 0.9)
        ax = 0.35 * math.sin(dt_rel / 1.3)
        ay = 0.28 * math.cos(dt_rel / 1.1)
        az = -9.806 + 0.4 * math.sin(dt_rel / 3.0)
        mx = 210 + 30 * math.sin(dt_rel / 4.0)
        my = -140 + 25 * math.cos(dt_rel / 4.0)
        mz = 380 + 20 * math.sin(dt_rel / 6.0)
        solar_on = bool((self.p_mech >> PQ_BIT_SOLAR_1) & 1)
        s1 = 4.60 + 0.25 * math.sin(dt_rel / 5.0) if solar_on else 0.0
        s2 = 4.45 + 0.25 * math.cos(dt_rel / 5.0) if solar_on else 0.0
        img = f"{0.5 * math.sin(dt_rel):.3f}"
        sci1 = f"{22.0 + 0.5 * math.sin(dt_rel / 3.0):.2f}"
        sci2 = f"{55 + int(5 * math.cos(dt_rel / 3.0))}"
        gnss_alt_s = "NaN" if 30.0 < dt_rel < 31.0 else f"{alt + 1.5:.1f}"
        return (f"{PQ_ID},{self.sim_mode_flag('P')},{t:.3f},{self.p_pkt},"
                f"{self.p_cmd},"
                f"{alt:.1f},{temp:.1f},{pres:.0f},{volt:.1f},{curr:.0f},"
                f"{gt},{gnss_alt_s},{lat:.6f},{lon:.6f},{sats},"
                f"{rx:.1f},{ry:.1f},{rz:.1f},{ax:.3f},{ay:.3f},{az:.3f},"
                f"{mx:.0f},{my:.0f},{mz:.0f},{s1:.2f},{s2:.2f},"
                f"{self.p_mech:02X},{self.p_echo},{img},{sci1},{sci2}")

    def container_rate_hz(self, t):
        """Container transmit rate at sim time t: 4 Hz, then 1 Hz from
        CONT_RATE_SWITCH_DELAY_S after PocketQube release."""
        if (self.t_release is not None
                and t >= self.t_release + CONT_RATE_SWITCH_DELAY_S):
            return CONT_RATE_HZ_POST
        return CONT_RATE_HZ_PRE

    def _container_due(self, t):
        """True if a container packet is due at sim time t.

        Schedules on sim time (next due = previous due + period), not by
        counting ticks, so it is drift-free, independent of self.speed and
        of the dt passed to step()."""
        eps = 1e-9
        nxt = self._c_next_emit_t
        if nxt is not None and t + eps < nxt:
            return False
        period = 1.0 / self.container_rate_hz(t)
        nxt = t if nxt is None else nxt
        nxt += period
        if nxt <= t + eps:                 # far behind (large dt): re-anchor on now
            nxt = t + period
        self._c_next_emit_t = nxt
        return True

    def step(self, dt=None):
        """
        Run one tick — split out as a method so it can be tested without the thread
        (verification scripts call it directly).

        In SIM mode: no telemetry is sent until that vehicle's sim_state is
        ACTIVE **and** a SIMP value (from the CSV) has arrived.  Keeps fake values
        from the math.sin formulas off the dashboard plots.
        """
        dt = self.DT if dt is None else dt
        with self.lock:
            # ── has SIMP data from the CSV arrived yet? ────────────────────
            c_has_simp = (self.sim_state["C"] == "ACTIVE"
                          and self.simp_pa["C"] is not None)
            p_has_simp = (self.sim_state["P"] == "ACTIVE"
                          and self.simp_pa["P"] is not None)

            t = self.t

            # Container — build a packet only once CSV data is available.
            # The state machine runs every tick; emission follows the rate schedule.
            line_c = None
            if c_has_simp:
                pres_c = self._pressure("C", t)
                alt_c = self._altitude("C", pres_c)
                self._advance_states(alt_c, t)
                if self._container_due(t):
                    line_c = self._container_line(t, alt_c, pres_c)

            # PocketQube
            line_p = None
            if (p_has_simp
                    and self.t_release is not None and t >= self.t_release):
                dt_rel = t - self.t_release
                pres_p = self._pressure("P", t)
                alt_p = self._altitude("P", pres_p)
                line_p = self._pq_line(t, alt_p, pres_p, dt_rel)

            self.t += dt

        if line_c is not None:
            self._emit("C", line_c)
        if line_p is not None:
            self._emit("P", line_p)

    def run(self):
        self._status("Virtual CanSat: started (PQ 4 Hz, container 4 Hz -> 1 Hz 5 s "
                     "after release, two vehicles, parallel radios). Press SIM ENABLE "
                     "→ SIM ACTIVATE, then start the SIMP stream to drive the mission")
        while not self.stop_ev.is_set():
            self.step()
            if self.stop_ev.wait(self.DT / self.speed):
                break


# ══════════════════════════════════════════════════════════════════════════════
#  SimpProfileSender — GS8, 1 Hz, deadline-based (no accumulated drift)
# ══════════════════════════════════════════════════════════════════════════════

class SimpProfileSender(threading.Thread):
    """
    sleep(1.0) per loop accumulates drift because the send time is not subtracted — a
    200 s profile would be off by several seconds.  So an absolute deadline is computed
    and awaited (next_deadline += 1.0) to keep the cadence constant across the file.
    """

    def __init__(self, rows, rx_q, stop_ev):
        super().__init__(daemon=True, name="simp-sender")
        self.rows = rows                     # [(raw_text, value_float)]
        self.rx_q = rx_q
        self.stop_ev = stop_ev
        self.pause_ev = threading.Event()
        self.sent = 0
        self._stamps = collections.deque(maxlen=SIMP_RATE_WINDOW + 1)

    def pause(self):
        self.pause_ev.set()

    def resume(self):
        self.pause_ev.clear()

    @property
    def paused(self):
        return self.pause_ev.is_set()

    def _rate_stats(self):
        """Return (mean_interval, achieved_hz, max_abs_drift) from the latest samples."""
        if len(self._stamps) < 2:
            return None, None, None
        gaps = [b - a for a, b in zip(self._stamps, list(self._stamps)[1:])]
        mean = sum(gaps) / len(gaps)
        drift = max(abs(g - SIMP_PERIOD_S) for g in gaps)
        return mean, (1.0 / mean if mean > 0 else None), drift

    def run(self):
        total = len(self.rows)
        self.rx_q.put(("STATUS", None,
                       f"SIMP: streaming {total} rows at 1 Hz (GS8)", None))
        t0 = time.monotonic()
        next_deadline = time.monotonic()
        for i, (raw_v, val) in enumerate(self.rows, start=1):
            if self.stop_ev.is_set():
                break
            # Paused — reset the deadline so counting restarts as soon as Resume is pressed
            while self.pause_ev.is_set():
                if self.stop_ev.wait(0.05):
                    break
                next_deadline = time.monotonic()
            if self.stop_ev.is_set():
                break

            wait = next_deadline - time.monotonic()
            if wait > 0 and self.stop_ev.wait(wait):
                break
            # Check pause again after the deadline wait so Pause takes effect immediately
            # instead of slipping one more row
            while self.pause_ev.is_set():
                if self.stop_ev.wait(0.05):
                    break
                next_deadline = time.monotonic()
            if self.stop_ev.is_set():
                break

            now = time.monotonic()
            self._stamps.append(now)
            self.sent = i
            mean, hz, drift = self._rate_stats()
            # Hand the uplink job to the UI thread through the telemetry queue
            # (tkinter is not thread-safe — never call a widget/after from this thread)
            self.rx_q.put(("SIMP_SAMPLE", None,
                           {"row": i, "total": total, "pressure": val,
                            "wire_value": raw_v,
                            "altitude": pressure_pa_to_alt(val),
                            "elapsed": now - t0,
                            # cumulative drift vs the ideal schedule — the figure that
                            # really proves 1 Hz to the judges (not an instantaneous value)
                            "cum_drift": (now - t0) - (i - 1) * SIMP_PERIOD_S,
                            "mean_interval": mean, "hz": hz, "drift": drift},
                           None))
            next_deadline += SIMP_PERIOD_S
            # if far behind (machine stalled), pull the deadline back to now
            if next_deadline < time.monotonic() - SIMP_PERIOD_S:
                next_deadline = time.monotonic() + SIMP_PERIOD_S

        done = "complete" if self.sent >= total else f"stopped at row {self.sent}"
        mean, hz, drift = self._rate_stats()
        rate_txt = "" if mean is None else \
            f" — achieved {hz:.4f} Hz (mean {mean:.4f} s, drift {drift * 1000:.0f} ms)"
        self.rx_q.put(("SIMP_DONE", None, f"SIMP: {done}{rate_txt}", None))


# ══════════════════════════════════════════════════════════════════════════════
#  Ground-station apogee detection (was the ALTITUDE tab)
# ══════════════════════════════════════════════════════════════════════════════

class ApogeeTracker:
    """
    Detect apogee from the container altitude sequence. Latches once per mission:
    after climbing above APOGEE_ASCENT_M and falling more than APOGEE_DROP_M from the peak,
    apogee = highest peak seen, then fixed (descent noise does not move it).
    """

    def __init__(self):
        self.max_alt = None
        self.apogee = None

    def reset(self):
        self.max_alt = None
        self.apogee = None

    def feed(self, alt, state=None):
        """Return True only "on the latch" so the caller logs exactly once."""
        if alt is None:
            return False
        if self.apogee is not None:
            # noise during ascent may latch too early — if a higher value appears, raise the line
            if alt > self.apogee:
                self.apogee = self.max_alt = alt
            return False
        if self.max_alt is None or alt > self.max_alt:
            self.max_alt = alt
        if self.max_alt >= APOGEE_ASCENT_M and (
                alt <= self.max_alt - APOGEE_DROP_M):
            self.apogee = self.max_alt
            return True
        # the FSW says APOGEE has passed (e.g. the peak packet was lost) — trust STATE
        if (str(state or "").strip().upper() in ("APOGEE", "PQ_RELEASE", "LANDED")
                and self.max_alt >= APOGEE_ASCENT_M):
            self.apogee = self.max_alt
            return True
        return False


# ══════════════════════════════════════════════════════════════════════════════
#  PocketQube state derivation (Task 3)
# ══════════════════════════════════════════════════════════════════════════════

PQ_LANDED_ALT_M = 3.0       # below this = on the ground (barometer noise guard)


def pq_state_from_packet(d, cam_turn_seen=False, landed_latched=False):
    """
    The PocketQube telemetry format in the Mission Guide **has no STATE column**,
    so we infer it from the MECH_STATE bits, which are "evidence the mechanism worked",
    not a guess that a command was sent:

        RELEASED      separated from the container (PQ packets are arriving)
        SOLAR_DEPLOY  bit 0 and/or bit 1 = solar panels deployed
        BOOM_DEPLOY   bit 2 = boom actually deployed (not when commanded)
        CAMERA_TURN   the CAM_SET command has rotated the camera
        LANDED        reached the ground

    bit 3 (camera recording) is set from separation onward, so it cannot indicate CAMERA_TURN
    — we look at the CMD_ECHO of CAM_SET instead.

    >>> If the flight software ever adds a real STATE column to the PQ packet,
    >>> switch to reading it directly in the block below — nothing else needs to change.
    """
    direct = d.get("STATE")
    if direct:
        s = str(direct).strip().upper()
        if s in PQ_STATES:
            return s

    # LANDED is a latch — once on the ground, ±1 m of noise must not bounce it back
    alt = to_float(d.get("ALTITUDE"))
    if landed_latched or (alt is not None and alt <= PQ_LANDED_ALT_M):
        return "LANDED"

    m = d.get("_MECH")
    echo = echo_token(str(d.get("CMD_ECHO", "")))
    if cam_turn_seen or echo.startswith(CAM_TURN_ECHOES):
        return "CAMERA_TURN"
    if m is None:
        return "RELEASED"
    if (m >> PQ_BIT_BOOM) & 1:
        return "BOOM_DEPLOY"
    if ((m >> PQ_BIT_SOLAR_1) & 1) or ((m >> PQ_BIT_SOLAR_2) & 1):
        return "SOLAR_DEPLOY"
    return "RELEASED"



def tile_count_for_box(lat_a, lon_a, lat_b, lon_b, z0, z1):
    """Estimate the number of tiles to download (slippy map) — shown before starting."""
    total = 0
    lat_top, lat_bot = max(lat_a, lat_b), min(lat_a, lat_b)
    lon_l, lon_r = min(lon_a, lon_b), max(lon_a, lon_b)
    for z in range(int(z0), int(z1) + 1):
        n = 2 ** z
        x0 = int((lon_l + 180.0) / 360.0 * n)
        x1 = int((lon_r + 180.0) / 360.0 * n)
        try:
            y0 = int((1.0 - math.asinh(math.tan(math.radians(lat_top)))
                      / math.pi) / 2.0 * n)
            y1 = int((1.0 - math.asinh(math.tan(math.radians(lat_bot)))
                      / math.pi) / 2.0 * n)
        except Exception:
            continue
        total += (abs(x1 - x0) + 1) * (abs(y1 - y0) + 1)
    return total


def map_cache_tile_count(path=MAP_DB_PATH):
    """Number of tiles in the cache — None if the file is missing/unreadable."""
    if not os.path.exists(path):
        return None
    try:
        con = sqlite3.connect(path)
        try:
            return con.execute(SQL_TILE_COUNT).fetchone()[0]
        finally:
            con.close()
    except Exception:
        return None


