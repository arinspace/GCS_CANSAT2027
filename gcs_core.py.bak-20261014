TYPED_ALIASES = {"MAC": "MEC"}      # team slides say MAC; Mission Guide / wire say MEC

# FSW SEQUENCE rows — from GCSApp._build_sidebar
SEQ_TITLES = (("apogee", "1 Apogee"), ("release", "2 PQ release"),
              ("solar", "3 Solar"), ("boom", "4 Boom"), ("cam", "5 Camera"))

COMMAND_SPECS = {c["name"]: c for _g, cmds in COMMAND_GROUPS for c in cmds}

# buttons that return from _send_spec before its argument prompt / destructive
# confirmation (bare SIM, SIMP, and the arming gate) — the browser skips its
# dialogs for exactly these, as the Tk app did
DIALOG_FREE_COMMANDS = ("SIM", "SIMP", "SIM ENABLE", "SIM ACTIVATE", "SIM DISABLE")


class NotifyingQueue(queue.Queue):
    """queue.Queue that calls notify() after every put.

    LinkReader, VirtualPayload and SimpProfileSender are unchanged and still just
    put() on rx_q; the notify hook wakes the asyncio drain task at once, so a packet
    is parsed and broadcast as soon as it arrives instead of on the next 120 ms poll."""

    def __init__(self, notify):
        super().__init__()
        self._notify = notify

    def put(self, item, block=True, timeout=None):
        super().put(item, block, timeout)
        self._notify()


def packet_values(vehicle, d):
    """Raw field values of one packet in log order: CONTAINER_FIELDS, or
    PQ_FIELDS + PQ_TRAILING (trailing groups come from _EXTRA, split the way
    the deleted PacketTable._value split them)."""
    if vehicle == "C":
        return [str(d.get(f, "")).strip() for f in CONTAINER_FIELDS]
    extra = d.get("_EXTRA", []) or []
    vals = [str(d.get(f, "")).strip() for f in PQ_FIELDS]
    vals.append(",".join(extra[:IMAGE_STAB_FIELD_COUNT]))
    vals.append(",".join(extra[IMAGE_STAB_FIELD_COUNT:]))
    return vals


def telemetry_text(vehicle, d):
    """GCSApp._telemetry_text — the single telemetry formatter: 'FIELD=value' pairs
    in Mission Guide field order (CONTAINER_FIELDS / PQ_FIELDS), two spaces apart."""
    fields = CONTAINER_FIELDS if vehicle == "C" else PQ_FIELDS
    return "  ".join(f"{f}={d.get(f, '')}" for f in fields)


def _tile_xy(lat, lon, z):
    """Slippy-map tile coordinates (float), as tkintermapview.decimal_to_osm."""
    n = 2.0 ** z
    x = (lon + 180.0) / 360.0 * n
    y = (1.0 - math.asinh(math.tan(math.radians(lat))) / math.pi) / 2.0 * n
    return x, y


def read_cached_tile(z, x, y, path=MAP_DB_PATH):
    """One tile image from the map cache (bytes) or None — serves MAP: OFFLINE."""
    if not os.path.exists(path):
        return None
    try:
        con = sqlite3.connect(path)
        try:
            row = con.execute(SQL_MAP_TILE_GET, (z, x, y, MAP_TILE_SERVER)).fetchone()
            if row is None:
                row = con.execute(SQL_MAP_TILE_GET_ANY, (z, x, y)).fetchone()
            return row[0] if row else None
        finally:
            con.close()
    except Exception:
        return None


def match_command_text(txt):
    """Typed text -> (spec, arg) when it starts with a command name from
    COMMAND_GROUPS (longest name wins, commas and spaces both separate words,
    case-insensitive; a leading MAC is read as MEC). Local FLIGHT ... names match
    too, so typing a command does exactly what its button does. Returns None
    otherwise, and the caller falls back to the original free-text path."""
    words = str(txt).replace(",", " ").split()
    if words and words[0].upper() in TYPED_ALIASES:
        words[0] = TYPED_ALIASES[words[0].upper()]
    norm = " ".join(words)
    up = norm.upper()
    best = None
    for name, spec in COMMAND_SPECS.items():
        n = name.upper()
        if (up == n or up.startswith(n + " ")) and (
                best is None or len(n) > len(best[0]["name"])):
            best = (spec, norm[len(n):].strip())
    return best


def hms_seconds(text):
    """'HH:MM:SS[.ff]' or 'HHMMSS[.ff]' (NMEA GNSS_TIME / ST argument) ->
    seconds of the day, or None if it is not a valid time of day."""
    s = str(text or "").strip()
    if not s or s.upper() in NAN_TOKENS:
        return None
    s = s.split(".")[0]
    parts = s.split(":") if ":" in s else (
        [s[0:2], s[2:4], s[4:6]] if len(s) == 6 else [])
    if len(parts) != 3 or not all(p.isdigit() and 1 <= len(p) <= 2 for p in parts):
        return None
    hh, mm, ss = (int(p) for p in parts)
    if hh > 23 or mm > 59 or ss > 59:
        return None
    return hh * 3600 + mm * 60 + ss


def hms_text(sec):
    sec = int(sec) % 86400
    return f"{sec // 3600:02d}:{sec // 60 % 60:02d}:{sec % 60:02d}"


def _finite(v):
    """JSON-safe number: NaN / inf / non-numbers -> None."""
    if isinstance(v, bool) or not isinstance(v, (int, float)):
        return None
    return v if math.isfinite(v) else None


