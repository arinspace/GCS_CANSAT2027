# ── Simulation command group ──────────────────────────────────────────────────
# Used only to "allow running through the virtual payload as a loopback without a
# serial link" — not a program mode switch. The real arm status is still decided
# from the telemetry the payload returns (GS16 / F6) in _update_sim_state_from_telemetry.
# Flight-group commands have no such shortcut — a real link is always required.
# Names are taken straight from COMMAND_GROUPS so the two lists cannot drift apart
SIM_GROUP_COMMANDS = frozenset(
    c["name"] for g, cmds in COMMAND_GROUPS if g == "Simulation" for c in cmds)


def is_sim_group_command(name):
    """True if this command name is in the Simulation group of COMMAND_GROUPS."""
    n = " ".join(str(name or "").upper().split())
    return n in SIM_GROUP_COMMANDS


