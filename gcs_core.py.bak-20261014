        "type": "config",
        "team_id": TEAM_ID, "container_id": CONTAINER_ID, "pq_id": PQ_ID,
        "container_fields": CONTAINER_FIELDS,
        "pq_fields": PQ_FIELDS,
        "pq_trailing": PQ_TRAILING,
        "pq_log_fields": PQ_FIELDS + PQ_TRAILING,
        "units": UNITS,
        "command_groups": [{"group": g, "tab": CMD_TAB_LABEL.get(g, g),
                            "commands": cmds} for g, cmds in COMMAND_GROUPS],
        "arg_prompts": ARG_PROMPTS,
        "dialog_free_commands": list(DIALOG_FREE_COMMANDS),
        "cam_step_deg": CAM_STEP_DEG,
        "cam_angle_max": CAM_ANGLE_MAX,
        "container_states": CONTAINER_STATES,
        "pq_states": PQ_STATES,
        "state_colors": STATE_COLORS,
        "state_hint": STATE_HINT,
        "mech_bits": MECH_BITS,
        "vehicle_color": VEHICLE_COLOR,
        "vehicle_name": VEHICLE_NAME,
        "vehicle_title": VEHICLE_TITLE,
        "radios": list(RADIOS),
        "radio_label": RADIO_LABEL,
        "link_keys": list(LINK_KEYS),
        "links": {k: {"vehicle": c["vehicle"], "radio": c["radio"],
                      "port": c.get("port", ""), "baud": c["baud"],
                      "channel": str(c.get("channel", "")),
                      "ident_key": "netid" if c["radio"] == "XBEE" else "peer_mac",
                      "ident": str(c.get("netid" if c["radio"] == "XBEE"
                                         else "peer_mac", ""))}
                  for k, c in links_cfg.items()},
        "ports": ports,
        "display_sources": list(DISPLAY_SOURCES),
        "display_source_label": DISPLAY_SOURCE_LABEL,
        "sim_sources": list(SIM_SOURCES),
        "sim_source_label": SIM_SOURCE_LABEL,
        "seq_titles": [list(t) for t in SEQ_TITLES],
        "theme": theme,
        "event_tag_colors": {t: theme[k] for t, k in EVENT_TAG_COLORS.items()},
        "chart_points": CHART_POINTS,
        "log_max_lines": LOG_MAX_LINES,
        "telemetry_log_max": TELEMETRY_LOG_MAX,
        "stale_link_s": STALE_LINK_S,
        "cmd_timeout_s": CMD_TIMEOUT_S,
        "apogee_color": APOGEE_COLOR,
        "release_line_color": RELEASE_LINE_COLOR,
        "apogee_release_frac": APOGEE_RELEASE_FRAC,
        "none_text": NONE_TEXT,
        "serial_ok": SERIAL_OK,
        # ── layout / plots, all from the Tk builders ──────────────────────
        "cmd_fixed_cols": CMD_FIXED_COLS,
        "sidebar_width": SIDEBAR_WIDTH,
        "font_min": FONT_MIN,
        "telem_col_min_w": TELEM_COL_MIN_W,
        "event_log_min_lines": EVENT_LOG_MIN_LINES,
        "container_plots": CONTAINER_PLOTS,
        "pq_plot_tabs": PQ_PLOT_TABS,
        "history_fields": HISTORY_FIELDS,
        "axis_colors": AXIS_COLORS,
        "plot": {"title": PLOT_TITLE_SIZE, "title_min": PLOT_TITLE_MIN,
                 "label": PLOT_LABEL_SIZE, "tick": PLOT_TICK_SIZE,
                 "line": PLOT_LINEWIDTH, "axis": PLOT_AXIS_WIDTH,
                 "xlabel": PLOT_XLABEL},
        "pkt_table_pt": PKT_TABLE_PT,
        "pkt_value_chars": PKT_VALUE_CHARS,
        "sim_state_text": SIM_STATE_TEXT,
        "map_home": MAP_HOME,
        "map_tile_server": MAP_TILE_SERVER,
        "map_cache_defaults": {"zoom_min": MAP_CACHE_ZOOM_MIN,
                               "zoom_max": MAP_CACHE_ZOOM_MAX,
